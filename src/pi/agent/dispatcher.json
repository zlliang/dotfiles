{
  "dispatcher": {
    "provider": "{{ "openai-codex" if "work" in mise_env else "deepseek" }}",
    "model": "{{ "gpt-5.6-luna" if "work" in mise_env else "deepseek-v4-flash" }}",
    "thinkingLevel": "off"
  },
  "candidates": [
    {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "thinkingLevels": ["medium", "high", "xhigh", "max"]
    },
    {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinkingLevels": ["off", "xhigh", "max"]
    }
    {%- if "work" in mise_env %},
    {
      "provider": "booking-genai",
      "model": "claude-opus-5",
      "thinkingLevels": ["high", "xhigh", "max"]
    },
    {
      "provider": "booking-genai",
      "model": "claude-sonnet-5",
      "thinkingLevels": ["xhigh", "max"]
    }
    {%- else %},
    {
      "provider": "fireworks",
      "model": "accounts/fireworks/routers/kimi-k3-fast"
    },
    {
      "provider": "deepseek",
      "model": "deepseek-v4-flash"
    }
    {%- endif %}
  ]
}
