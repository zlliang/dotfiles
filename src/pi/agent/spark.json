{
  "editor": {
    "thinkingLevelIndicator": "model"
  },
  "presets": {
    "ultra": {
      "provider": "openai-codex",
      "model": "gpt-6-astra",
      "thinkingLevel": "high"
    }
    {%- if "work" in mise_env %},
    "high": {
      "provider": "booking-genai",
      "model": "claude-opus-5",
      "thinkingLevel": "xhigh"
    },
    "medium": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinkingLevel": "xhigh"
    },
    "low": {
      "provider": "booking-genai",
      "model": "gpt-5.6-luna",
      "thinkingLevel": "medium"
    }
    {%- else %},
    "high": {
      "provider": "openai-codex",
      "model": "gpt-6-sol",
      "thinkingLevel": "xhigh"
    },
    "medium": {
      "provider": "openai-codex",
      "model": "gpt-6-luna",
      "thinkingLevel": "xhigh"
    },
    "low": {
      "provider": "deepseek",
      "model": "deepseek-flash",
      "thinkingLevel": "high"
    }
    {%- endif %}
  },
  "recap": {
    {%- if "work" in mise_env %}
    "provider": "openai-codex",
    "model": "gpt-5.6-luna",
    {%- else %}
    "provider": "deepseek",
    "model": "deepseek-flash",
    {%- endif %}
    "thinkingLevel": "off"
  },
  "title": {
    {%- if "work" in mise_env %}
    "provider": "openai-codex",
    "model": "gpt-5.6-luna",
    {%- else %}
    "provider": "deepseek",
    "model": "deepseek-flash",
    {%- endif %}
    "thinkingLevel": "off"
  }
}
