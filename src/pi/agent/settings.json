{
  {%- set last_changelog_version = exec(command="jq -r \".lastChangelogVersion // empty\" \"$HOME/.pi/agent/settings.json\" 2>/dev/null || true") %}
  {%- if last_changelog_version %}
  "lastChangelogVersion": "{{ last_changelog_version }}",
  {%- endif %}
  {%- set device_id = exec(command="jq -r \".deviceId // empty\" \"$HOME/.pi/agent/settings.json\" 2>/dev/null || true") %}
  {%- if device_id %}
  "deviceId": "{{ device_id }}",
  {%- endif %}
  "theme": "github-light-default/github-dark-default",
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "treeFilterMode": "no-tools",
  "packages": [
    {%- if "work" in mise_env %}
    "git:gitlab.com/{{ vars.GITLAB_NAMESPACE }}/pi-agent/pi-booking-genai.git",
    {%- endif %}
    "git:github.com/zlliang/pi-spark"
  ],
  "markdown": {
    "codeBlockIndent": ""
  },
  "collapseChangelog": true,
  "defaultProjectTrust": "always",
  {%- if "work" in mise_env %}
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "medium"
  {%- else %}
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-flash",
  "defaultThinkingLevel": "high"
  {%- endif %}
}
